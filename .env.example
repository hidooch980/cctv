# Molido CCTV AI Environment Variables
PROJECT_NAME=Molido CCTV AI
VERSION=0.1.0
API_V1_STR=/api/v1

# Security
SECRET_KEY=molido-super-secret-dev-key-change-in-production-min32chars
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (SQLite default or PostgreSQL: postgresql+asyncpg://user:pass@localhost:5432/cctv)
DATABASE_URL=sqlite+aiosqlite:///./cctv.db

# Capacity
MAX_CAMERAS_CAPACITY=100

# Default Initial Administrator
DEFAULT_ADMIN_USERNAME=admin
DEFAULT_ADMIN_EMAIL=admin@molido.ai
DEFAULT_ADMIN_PASSWORD=Admin@123456

# Storage Paths
STORAGE_PATH=./storage
SNAPSHOT_DIR=./storage/snapshots
RECORDING_DIR=./storage/recordings
